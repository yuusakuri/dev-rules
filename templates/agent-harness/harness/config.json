{
  "deadline": "2030-01-01T18:00:00+09:00",
  "final_phase_minutes": 40,
  "stall_minutes": 30,
  "baseline_runs": 3,
  "keep_margin": 0.05,
  "evaluate_timeout_seconds": 600,
  "log_tail_lines": 30,
  "hard_stop_grace_seconds": 0,
  "restart_backoff_seconds": 30,
  "run_dir": "runs/current",
  "agents": {
    "claude": {
      "session_id": "generate",
      "start": [
        "claude",
        "-p",
        "{prompt}",
        "--session-id",
        "{session_id}",
        "--permission-mode",
        "bypassPermissions",
        "--output-format",
        "stream-json",
        "--verbose"
      ],
      "resume": [
        "claude",
        "-p",
        "{prompt}",
        "--resume",
        "{session_id}",
        "--permission-mode",
        "bypassPermissions",
        "--output-format",
        "stream-json",
        "--verbose"
      ]
    },
    "codex": {
      "session_id": {
        "event": {
          "type": "thread.started"
        },
        "field": "thread_id"
      },
      "start": [
        "codex",
        "exec",
        "--json",
        "--dangerously-bypass-approvals-and-sandbox",
        "--dangerously-bypass-hook-trust",
        "-c",
        "projects.\"{root}\".trust_level=\"trusted\"",
        "{prompt}"
      ],
      "resume": [
        "codex",
        "exec",
        "resume",
        "{session_id}",
        "--json",
        "--dangerously-bypass-approvals-and-sandbox",
        "--dangerously-bypass-hook-trust",
        "-c",
        "projects.\"{root}\".trust_level=\"trusted\"",
        "{prompt}"
      ]
    }
  }
}
