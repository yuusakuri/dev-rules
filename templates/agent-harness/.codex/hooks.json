{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [{ "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/harness/harness.py\" hook session-start" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [{ "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/harness/harness.py\" hook pre-tool-use" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [{ "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/harness/harness.py\" hook post-tool-use" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/harness/harness.py\" hook stop" }]
      }
    ]
  }
}
